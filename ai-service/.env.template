# Rename this file to .env and fill in your key.
# .env is gitignored. Never commit it, never paste a real key into a chat.

# From platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional overrides - defaults live in app/config.py
# MODEL=gpt-4o-mini
# MAX_TOKENS=1000
# MAX_PICKS=3

# Shared secret the Android app must send as X-App-Token.
# Must match APP_TOKEN in android-app/app/build.gradle.
APP_TOKEN=change-me-before-you-ship
