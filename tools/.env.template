# Rename this file to .env and fill in ONE of the two keys below.
# .env is gitignored. Never commit it, never paste a real key into a chat.

# --- Pick one ------------------------------------------------------------
# From console.anthropic.com
ANTHROPIC_API_KEY=

# From platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Optional ------------------------------------------------------------
# If you have both keys, this decides which is used: anthropic | openai
# LLM_PROVIDER=openai

# Override the model. Defaults: claude-sonnet-4-5 / gpt-4o-mini
# LLM_MODEL=gpt-4o

# openFDA works without a key; one just raises the rate limit from
# 1,000 to 120,000 requests/day. https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# Only needed for --source ebay. Free at developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
